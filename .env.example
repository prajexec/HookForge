NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PORT=3000
WEB_PORT=5173
MOCK_RECEIVER_PORT=8080
MOCK_RECEIVER_MAX_REQUESTS=100
MOCK_RECEIVER_MAX_TOKENS=1000
MOCK_RECEIVER_MAX_BODY_BYTES=262144
LOG_LEVEL=info
DATABASE_URL=postgresql://hookforge:hookforge_dev_only@localhost:5432/hookforge
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ENTRIES=10000
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_EVENT_MAX_REQUESTS=120
RATE_LIMIT_EVENT_WINDOW_SECONDS=60
SESSION_TTL_SECONDS=86400
MAX_EVENT_PAYLOAD_BYTES=131072
SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ALLOW_PRIVATE_ENDPOINTS=false
SANDBOX_ENABLED=true
SANDBOX_RECEIVER_INTERNAL_URL=http://localhost:8080
SANDBOX_RECEIVER_PUBLIC_URL=http://localhost:8080
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=250
WORKER_LEASE_SECONDS=60
WORKER_REQUEST_TIMEOUT_MS=10000
MAX_DELIVERY_ATTEMPTS=8
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=3600000
RETRY_JITTER_RATIO=0.2
MAX_RESPONSE_BYTES=8192
WORKER_ID=worker-1
WORKER_HEARTBEAT_INTERVAL_MS=5000

# Compose defaults. These values are for local development only.
POSTGRES_USER=hookforge
POSTGRES_PASSWORD=hookforge_dev_only
POSTGRES_DB=hookforge
