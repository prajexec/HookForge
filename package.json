{
  "name": "hookforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "bench": "k6 run benchmarks/api.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:retention": "tsx scripts/retention.ts",
    "db:rotate-encryption-key": "tsx scripts/rotate-encryption-key.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/verify-openapi.ts",
    "dev:api": "npm --workspace @hookforge/api run dev",
    "dev:web": "npm --workspace @hookforge/web run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start:api": "npm --workspace @hookforge/api run start",
    "start:worker": "npm --workspace @hookforge/worker run start",
    "test": "vitest run apps packages",
    "test:integration": "npm run db:migrate && vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=100",
    "compose:build": "docker compose build",
    "compose:ps": "docker compose ps",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.33",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "pg": "^8.23.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
